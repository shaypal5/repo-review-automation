{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "category",
          "severity",
          "confidence",
          "summary",
          "evidence",
          "recommended_fix"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 5
          },
          "category": {
            "type": "string",
            "minLength": 3
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "summary": {
            "type": "string",
            "minLength": 20
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "recommended_fix": {
            "type": "string",
            "minLength": 20
          },
          "proposed_issue_body": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  }
}
